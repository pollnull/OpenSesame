{
  "name": "opensesame",
  "productName": "OpenSesame",
  "version": "1.5.0",
  "description": "Encrypts any file with its own password into a private vault (.sesame files)",
  "author": "PollNull",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "https://github.com/pollnull/OpenSesame.git"
  },
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win portable",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.opensesame.app",
    "productName": "OpenSesame",
    "files": [
      "main.cjs",
      "preload.cjs",
      "cli.cjs",
      "web/**"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "OpenSesame-${version}-portable.exe"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Utility",
      "executableName": "opensesame",
      "maintainer": "PollNull <pollnull@users.noreply.github.com>",
      "artifactName": "OpenSesame-${version}-${arch}.${ext}"
    },
    "copyright": "Copyright 2026 PollNull"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "hash-wasm": "4.12.0"
  }
}
